#!/usr/bin/env python3
"""Test-only bitcoind → rbitcoin-node adapter. Not the operator CLI.

Maps Core TestNode argv + bitcoin.conf onto rbitcoin-node flags.
`-datadir=DIR` becomes `--datadir DIR/regtest` so the cookie lands at
`DIR/regtest/.cookie` (what BitcoinTestFramework tails).
"""

from __future__ import annotations

import os
import shutil
import signal
import subprocess
import sys
import threading
from pathlib import Path

from map_debuglog import apply_line, load_rules

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]


def parse_kv(arg: str) -> tuple[str, str | None]:
    a = arg[1:] if arg.startswith("-") else arg
    # Core uses -name or -name=value (one dash). Allow --name too.
    a = a[1:] if a.startswith("-") else a
    if "=" in a:
        k, v = a.split("=", 1)
        return k, v
    return a, None


def read_conf(path: Path) -> dict[str, str]:
    """Read bitcoin.conf. Later [section] keys override earlier ones."""
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or line.startswith("["):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip().lower()] = v.strip()
    return out


def maybe_seed_store(node_dir: Path) -> None:
    """Copy the rbitcoin 199-block store into a Core cache-shaped datadir.

    Core `_initialize_chain` copies `blocks/` + `chainstate/` then starts the
    node. Those empty dirs are the signal that this is a cached start, not a
    clean chain. We never copy Core LevelDB; only our `store/`.
    """
    cache = os.environ.get("RBITCOIN_CACHE")
    if not cache:
        return
    src = Path(cache) / "store"
    dest = node_dir / "store"
    if dest.exists() or not src.is_dir():
        return
    if not ((node_dir / "blocks").is_dir() and (node_dir / "chainstate").is_dir()):
        return
    shutil.copytree(src, dest)


def find_node() -> Path:
    env = os.environ.get("RBITCOIN_NODE")
    if env:
        p = Path(env)
        if not p.is_absolute():
            p = ROOT / p
        if p.is_file():
            return p
        raise SystemExit(f"RBITCOIN_NODE={env} is not a file")
    cands: list[Path] = []
    td = os.environ.get("CARGO_TARGET_DIR")
    if td:
        cands += [Path(td) / "debug" / "rbitcoin-node", Path(td) / "release" / "rbitcoin-node"]
    cands += [
        ROOT / "target/dev/debug/rbitcoin-node",
        ROOT / "target/debug/rbitcoin-node",
    ]
    for c in cands:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    which = shutil.which("rbitcoin-node")
    if which:
        return Path(which)
    raise SystemExit(
        "rbitcoin-node not found; set RBITCOIN_NODE or cargo build -p rbitcoin-node"
    )


def translate(argv: list[str]) -> tuple[list[str], Path]:
    """Return (rbitcoin-node argv including binary, node datadir)."""
    datadir: Path | None = None
    rpcport: str | None = None
    p2pport: str | None = None
    network = "regtest"
    debug = False
    want_help = False
    want_version = False
    uacomments: list[str] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("--print-cmd",):
            i += 1
            continue
        key, val = parse_kv(a)
        if val is None and key in (
            "datadir",
            "rpcport",
            "port",
            "bind",
            "uacomment",
            "loglevel",
            "conf",
        ):
            i += 1
            if i >= len(argv):
                raise SystemExit(f"bitcoind: {a} requires a value")
            val = argv[i]
        if key == "datadir":
            datadir = Path(val or "")
        elif key == "rpcport":
            rpcport = val
        elif key == "port":
            p2pport = val
        elif key == "bind" and val:
            # Skip Core's extra onion bind (127.0.0.1:P=onion).
            if val.endswith("=onion") or "=onion" in val:
                pass
            else:
                hostport = val.split("=", 1)[0]
                if ":" in hostport:
                    p2pport = hostport.rsplit(":", 1)[1]
        elif key == "regtest":
            network = "regtest"
        elif key == "uacomment":
            uacomments.append(val or "")
        elif key in ("h", "help"):
            want_help = True
        elif key == "version":
            want_version = True
        elif key in ("debug",) or (key == "loglevel" and val):
            debug = True
        elif key in (
            "server",
            "disablewallet",
            "v2transport",
            "logtimemicros",
            "debugexclude",
            "logthreadnames",
            "logsourcelocations",
            "nologratelimit",
            "print-cmd",
            # Core TestNode / MiniWallet extras we do not implement as flags.
            "whitelist",
            "persistmempool",
            "acceptnonstdtxn",
            "minrelaytxfee",
            "blocksonly",
            "peerblockfilters",
            "txindex",
        ):
            pass
        else:
            print("Error parsing command line arguments", file=sys.stderr)
            raise SystemExit(1)
        i += 1

    if want_help:
        print("Options")
        print("rbitcoin-node (test-only bitcoind shim)")
        raise SystemExit(0)
    if want_version:
        print("rbitcoin-node version")
        raise SystemExit(0)

    if datadir is None:
        raise SystemExit("bitcoind: -datadir is required")

    conf = read_conf(datadir / "bitcoin.conf")
    if conf.get("regtest") in ("1", "true"):
        network = "regtest"
    if rpcport is None:
        rpcport = conf.get("rpcport")
    if p2pport is None:
        p2pport = conf.get("port")
    if rpcport is None:
        rpcport = "18443"
    if p2pport is None:
        p2pport = "18444"

    node_dir = datadir / network
    node_dir.mkdir(parents=True, exist_ok=True)
    maybe_seed_store(node_dir)

    node = find_node()
    cmd = [
        str(node),
        "--network",
        network,
        "--datadir",
        str(node_dir),
        "--rpc-listen",
        f"127.0.0.1:{rpcport}",
        "--listen",
        f"127.0.0.1:{p2pport}",
        "--no-seeds",
    ]
    if debug:
        cmd += ["--log-level", "debug"]
    for c in uacomments:
        cmd += [f"--uacomment={c}"]
    return cmd, node_dir


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv if argv is None else argv)
    print_cmd = "--print-cmd" in argv
    cmd, node_dir = translate(argv)
    pid_path = node_dir / "bitcoind.pid"
    if print_cmd:
        print(" ".join(cmd))
        print(f"pidfile {pid_path}", file=sys.stderr)
        return 0
    pid_path.write_text(f"{os.getpid()}\n")
    # TestNode tails this process's stderr and requires it empty on a clean
    # stop. Core writes logs to debug.log (printtoconsole=0). Keep that shape:
    # node stdio → {datadir}/debug.log; only `Error:` lines on shim stderr.
    log_path = node_dir / "debug.log"
    prior = log_path.stat().st_size if log_path.is_file() else 0
    log_f = open(log_path, "ab", buffering=0)
    for i, a in enumerate(cmd):
        if a == "--listen" and i + 1 < len(cmd):
            log_f.write(f"Bound to {cmd[i + 1]}\n".encode())
            break
    map_path = HERE / "debuglog_map.toml"
    rules = load_rules(map_path) if map_path.is_file() else []
    try:
        child = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0
        )
    except OSError as e:
        log_f.close()
        print(f"bitcoind: failed to start node: {e}", file=sys.stderr)
        return 1

    def _pump() -> None:
        assert child.stdout is not None
        for raw in iter(child.stdout.readline, b""):
            log_f.write(raw)
            text = raw.decode("utf-8", errors="replace")
            for mapped in apply_line(text, rules):
                log_f.write((mapped + "\n").encode())
            log_f.flush()

    pump = threading.Thread(target=_pump, daemon=True)
    pump.start()

    def _forward(signum: int, _frame: object) -> None:
        try:
            child.send_signal(signum)
        except OSError:
            pass

    signal.signal(signal.SIGTERM, _forward)
    signal.signal(signal.SIGINT, _forward)
    rc = child.wait()
    pump.join(timeout=2)
    log_f.close()
    if rc:
        try:
            with log_path.open("rb") as f:
                f.seek(prior)
                text = f.read().decode("utf-8", errors="replace")
        except OSError:
            text = ""
        errs = [ln for ln in text.splitlines() if ln.startswith("Error:")]
        if errs:
            print("\n".join(errs), file=sys.stderr)
    return int(rc) if rc is not None else 1


if __name__ == "__main__":
    sys.exit(main())
